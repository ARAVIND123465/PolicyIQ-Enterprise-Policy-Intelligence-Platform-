# PolicyAI Frontend — Environment Variables
# Copy this file to .env and adjust values.
# Variables must be prefixed with VITE_ to be exposed to the browser.

# Backend API URL (for local dev: http://127.0.0.1:8000 ; for production: your backend Vercel URL)
VITE_API_URL=https://policy-iq-enterprise-policy-intelli-three.vercel.app
VITE_API_BASE_URL=https://policy-iq-enterprise-policy-intelli-three.vercel.app
